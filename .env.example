# =============================================================================
# Enterprise NotebookLM — environment template (copy to `.env`)
# Phase 1.1: infrastructure defaults for Docker Compose local development.
# Do NOT commit real secrets. Replace values before any shared/staging deploy.
# =============================================================================

APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=notebooklm
POSTGRES_PASSWORD=notebooklm
POSTGRES_DB=notebooklm
POSTGRES_PORT=5432

# --- Redis (Celery broker + outer cache tier for query_cache) ---
REDIS_PORT=6379

# --- Vector store: qdrant (default) | pgvector ---
VECTOR_STORE=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Elasticsearch (single-node, security disabled for local/dev) ---
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=notebooklm-documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Neo4j Community ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=notebooklm
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- App ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Host-run Next.js (npm run dev): use localhost. Docker Compose frontend
# overrides this to http://backend-api:8000 — do not rely on this value in Compose.
API_INTERNAL_BASE_URL=http://localhost:8000

# --- Logging / Observability (FR13 foundation) ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=enterprise-notebooklm-backend
# Leave empty when no collector is running (startup must not fail).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set true to dump spans to stdout (noisy; useful for local debugging).
OTEL_CONSOLE_EXPORTER=false

# --- Auth / JWT (FR12) — NEVER commit real secrets ---
# Override JWT_SECRET_KEY in every shared/staging/prod environment.
JWT_SECRET_KEY=dev-only-change-me-enterprise-notebooklm-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend runtime URLs (Compose overrides hostnames inside containers) ---
DATABASE_URL=postgresql+asyncpg://notebooklm:notebooklm@localhost:5432/notebooklm
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- FR2 Document pipeline adapters (host-local defaults) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=document_chunks
NEO4J_URI=bolt://localhost:7687
EMBEDDING_MODEL_NAME=local-hash-embedding-v1
EMBEDDING_DIMENSION=384
# local | openai | voyage — Celery may call OpenAI/Voyage *embedding* APIs (not Anthropic LLM)
EMBEDDING_PROVIDER=local
# EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
# Chunking token budget (tiktoken cl100k_base when installed; else char approx)
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_RATIO=0.12
QDRANT_COLLECTION=document_chunks

# --- API rate limit per workspace (FR12) — not LLM call quota ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- LLM / Graph Extraction (FR2 Step 5 — ONLY ingestion stage with chat LLM cost) ---
# Prefer Haiku for structured entity/topic extraction (cheaper than Sonnet).
# Architecture prefers Anthropic via backend-api; worker may call when enabled.
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE=https://api.anthropic.com
GRAPH_LLM_ENABLED=false
GRAPH_LLM_MODEL=claude-3-5-haiku-latest
GRAPH_LLM_MAX_TOKENS=4096
GRAPH_LLM_MAX_INPUT_CHARS=100000

# --- FR2 Step 3 (v3) Document Understanding — LlamaParse (NOT an LLM call) ---
# Only celery-worker talks to LlamaParse; billed separately from Anthropic.
# DOCUMENT_PARSER=llamaparse requires LLAMAPARSE_API_KEY; use local for offline dev/CI.
DOCUMENT_PARSER=llamaparse
# LLAMAPARSE_API_KEY=llx-...
LLAMAPARSE_BASE_URL=https://api.cloud.llamaindex.ai
LLAMAPARSE_TIMEOUT_SECONDS=120
LLAMAPARSE_MAX_RETRIES=3
LLAMAPARSE_RETRY_MIN_WAIT=1
LLAMAPARSE_RETRY_MAX_WAIT=30
LLAMAPARSE_CB_FAILURE_THRESHOLD=5
LLAMAPARSE_CB_RESET_TIMEOUT=60
LLAMAPARSE_CB_SUCCESS_THRESHOLD=1
# fast | cost_effective | agentic | agentic_plus — 'fast' cannot return markdown/items
LLAMAPARSE_TIER=cost_effective
LLAMAPARSE_POLL_INTERVAL_SECONDS=2.0

# --- FR2 Step 3 OCR P3 — language detection + optional scanned-PDF OCR ---
OCR_LANGUAGE_DETECTION_ENABLED=true
# false = one document-level detect copied onto segments (keeps overhead << 10%)
OCR_LANGUAGE_DETECT_PER_SEGMENT=false
OCR_LANGUAGE_MIN_CHARS=40
OCR_LANGUAGE_TIMEOUT_SECONDS=0.25
# Scanned PDF with no text layer — requires system Tesseract + pytesseract/Pillow
ENABLE_IMAGE_OCR=false
IMAGE_OCR_DPI=200
IMAGE_OCR_MAX_PAGES=50
IMAGE_OCR_TIMEOUT_SECONDS=30
IMAGE_OCR_LANG=eng+vie
# Optional — leave empty to auto-detect Windows install / PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=%LOCALAPPDATA%\Tesseract-OCR\tessdata
