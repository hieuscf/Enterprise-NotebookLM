# =============================================================================
# File: Dockerfile.dev
# Module/Service: Web App
# Layer: UI
# Purpose: Development image running Next.js `next dev` with hot reload.
# Responsibilities:
#   - Install dependencies and start the Next.js development server
# Dependencies:
#   - Node 22, package.json / package-lock.json
# Public Exports:
#   - N/A
# Database/Table: N/A
# Related Modules: docker-compose.yml, docker-compose.override.yml
# Important Notes: Production image remains in Dockerfile (standalone build).
# =============================================================================

FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache wget

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
